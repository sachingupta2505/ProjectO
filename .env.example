# ----------------------------------------------------------------------
# Trading Bot Environment Configuration
# ----------------------------------------------------------------------

# Set to True to simulate trades without using real capital
PAPER_TRADING=True

# Active Broker: 'paper' or 'angel'
BROKER=paper

# Initial virtual balance for Paper Trading (in INR)
PAPER_INITIAL_CAPITAL=200000

# ----------------------------------------------------------------------
# Angel One SmartAPI Configuration
# ----------------------------------------------------------------------
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_client_code
ANGEL_PIN=your_account_pin
ANGEL_TOTP_KEY=your_totp_secret_key

# ----------------------------------------------------------------------
# Risk Management Defaults (Override in config/settings.py if needed)
# ----------------------------------------------------------------------
MAX_DAILY_LOSS=6000
MAX_DAILY_PROFIT=11000
NIFTY_LOT_SIZE=65
CRUDE_LOT_SIZE=10

# ----------------------------------------------------------------------
# Telegram Mobile Bridge Configuration
# ----------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_personal_chat_id
