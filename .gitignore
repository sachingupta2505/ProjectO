# Environment and Secrets
.env
.env.*
!.env.example
key.txt
*.key
*.pem

# Data & Scrip masters (large files / local caches)
data/scrip_master.json
data/*.json
data/historical/
oc.json

# Logs & dynamic state
logs/
*.log
runs/

# Python cache & virtualenvs
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/

# Third-party repositories are cloned locally by scripts/bootstrap_third_party.ps1.
# Keep only the manifest under version control; never vendor external repositories
# into ProjectO without an explicit licence review.
third_party/*
!third_party/README.md

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
